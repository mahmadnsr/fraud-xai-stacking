# Copy to .env (or run `python scripts/init_env.py`, which generates real random keys for you).
# NEVER commit .env. Values below are placeholders and are rejected by the validator.
APP_ENV=development                     # development | production
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES   # AES-256-GCM key for data at rest
MODEL_SIGNING_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTES  # HMAC key protecting model artifacts
# Users: generate entries with `python scripts/create_user.py NAME admin|analyst`
AUTH_USERS_JSON={}
# Local development ONLY (refused when APP_ENV=production):
# AUTH_DISABLED=true
MAX_UPLOAD_MB=50
MAX_ROWS=400000
LOG_LEVEL=INFO
